---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

{
  name === 'lock' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <rect x="5" y="11" width="14" height="9" rx="2"></rect>
      <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
    </svg>
  )
}
{
  name === 'frame' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <rect x="3" y="4" width="18" height="14" rx="2"></rect>
      <path d="M8 21h8M12 18v3"></path>
      <path d="M8 9l2.5 2.5L15 8"></path>
    </svg>
  )
}
{
  name === 'cast' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="9" cy="8" r="3"></circle>
      <path d="M3.5 19c.6-2.6 2.7-4 5.5-4s4.9 1.4 5.5 4"></path>
      <circle cx="17" cy="9" r="2.2"></circle>
      <path d="M16.2 15.2c1.6.3 2.9 1.2 3.6 2.8"></path>
    </svg>
  )
}
{
  name === 'price' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M12 3v18"></path>
      <path d="M16.5 7.5c0-1.5-1.8-2.5-4.5-2.5S7.5 6 7.5 7.8 9.2 10.2 12 10.5s4.8 1.2 4.8 3.2-2 3.3-4.8 3.3-4.5-1.1-4.5-2.7"></path>
    </svg>
  )
}
{
  name === 'license' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M7 3h8l4 4v14H7z"></path>
      <path d="M15 3v5h5"></path>
      <path d="M9 13h6M9 17h4"></path>
    </svg>
  )
}
{
  name === 'clips' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="M10 9.2v5.6l5-2.8-5-2.8z" fill="currentColor" stroke="none"></path>
    </svg>
  )
}

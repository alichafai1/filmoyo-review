---
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="logo" href={href}>
  <svg class="logo-mark" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
    <circle cx="18" cy="18" r="15" fill="none" stroke="#E50914" stroke-width="2.2"></circle>
    <circle cx="18" cy="18" r="4" fill="#E50914"></circle>
    <circle cx="18" cy="8" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="25.1" cy="11" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="28" cy="18" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="25.1" cy="25" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="18" cy="28" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="10.9" cy="25" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="8" cy="18" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
    <circle cx="10.9" cy="11" r="2.15" fill="#FFFFFF" stroke="#E50914" stroke-width="1.3"></circle>
  </svg>
  <span class="logo-word">Filmoyo Review</span>
</a>

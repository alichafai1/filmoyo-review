---
import { affiliateUrl } from '../lib/affiliate';

interface Props {
  extraClass?: string;
  id?: string;
}

const { extraClass, id } = Astro.props;
---

<a
  id={id}
  class:list={['btn', extraClass]}
  href={affiliateUrl}
  target="_blank"
  rel="noopener noreferrer sponsored"
>
  <slot />
</a>

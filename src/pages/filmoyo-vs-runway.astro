---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateCta from '../components/AffiliateCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { personalPrice } from '../lib/affiliate';

const rows = [
  {
    label: 'Price',
    runway: 'Monthly. Plans often start around $15 and keep billing.',
    filmoyo: `$${personalPrice} once for the personal studio.`,
  },
  {
    label: 'Built for',
    runway: 'A clip or a VFX shot.',
    filmoyo: 'A short film with a cast that returns.',
  },
  {
    label: 'Character consistency',
    runway: 'Each generation starts from that shot’s prompt. The face often drifts.',
    filmoyo: 'Character Lock sends one reference sheet into every shot.',
  },
  {
    label: 'Workflow',
    runway: 'Text to a clip.',
    filmoyo: 'One logline to a storyboard, then you approve each frame.',
  },
  {
    label: 'You own the studio',
    runway: 'Access follows the subscription.',
    filmoyo: 'The license stays after you stop paying a monthly bill. Credits are still finite.',
  },
];

const shots = [
  { src: '/images/character-lock-1.jpg', label: 'Dunes', alt: 'The Wayfinder on desert dunes at sunset' },
  { src: '/images/character-lock-2.jpg', label: 'Jungle', alt: 'The Wayfinder in a jungle river at night, holding a sealed letter' },
  { src: '/images/character-lock-6.jpg', label: 'Summit', alt: 'The Wayfinder at a mountain cabin at sunrise, holding the same letter' },
];

const faqs = [
  {
    question: 'Is Filmoyo better than Runway?',
    answer:
      'For a short film with one recurring actor, yes. Runway is the stronger pick when the job is a single effects shot. Filmoyo is the pick when the same person has to survive the next scene.',
  },
  {
    question: 'Does Runway have Character Lock?',
    answer:
      'Runway is a clip generator. You can try to steer a face with references, but the product is built to render that shot. Filmoyo locks a reference sheet and injects it into every shot of the film.',
  },
  {
    question: 'Is Runway cheaper?',
    answer: `A monthly plan can look cheaper in week one. At about $15 a month, a year is $180. Filmoyo’s personal studio is $${personalPrice} once. Runway’s listed price changes, so check their page before you compare the bill.`,
  },
  {
    question: 'Can Runway make a full short film?',
    answer:
      'You can stitch clips you generated one at a time. You are the person keeping the cast consistent. Filmoyo drafts the storyboard from one sentence and holds the cast as part of the workflow.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Filmoyo vs. Runway: Which AI Video Tool is Better for Filmmakers?"
  description="Filmoyo vs Runway: Runway makes clips and VFX shots on a monthly plan. Filmoyo is a one-time film studio with Character Lock, so the same actor can last from scene to scene."
  canonicalURL="/filmoyo-vs-runway"
  schema={faqSchema}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Filmoyo vs Runway', href: '/filmoyo-vs-runway' },
      ]}
    />
  </div>

  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Comparison</p>
      <h1>Filmoyo vs. Runway</h1>
      <p class="lede" style="margin-top: 0.9rem; max-width: 42rem;">
        Runway is a clip generator for VFX artists. Filmoyo is a full film studio for storytellers who need the same character in scene 1 and scene 10. One bills monthly for shots. The other is ${personalPrice} once, then you direct.
      </p>
      <div class="hero-actions" style="margin-top: 1.3rem; justify-content: flex-start;">
        <AffiliateCta id="get-filmoyo" extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <div class="section-head">
        <p class="eyebrow">Side by side</p>
        <h2 class="section-title">Price, the face, and the workflow.</h2>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"> </th>
              <th scope="col">Runway</th>
              <th scope="col">Filmoyo</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td>{row.label}</td>
                <td>{row.runway}</td>
                <td>{row.filmoyo}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta extraClass="btn-lg">Get the one-time studio →</AffiliateCta>
      </div>

      <div class="section-head">
        <p class="eyebrow">The difference you can see</p>
        <h2 class="section-title">The face is supposed to survive the cut.</h2>
        <p class="lede">
          Filmoyo keeps a reference sheet for the actor and sends that sheet into every shot. That is why the Wayfinder below is still the same person in the dunes, the jungle, and on the summit. A clip tool starts the next generation from the prompt for that shot. Without a locked sheet, the face often comes back as someone else. You can wrestle a reference into Runway. The product is still built to deliver a clip, not a cast.
        </p>
      </div>
      <ul class="filmstrip cols-3">
        {shots.map((shot) => (
          <li>
            <figure>
              <img src={shot.src} width="1280" height="704" alt={shot.alt} loading="lazy" />
              <figcaption>{shot.label}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta>Lock the cast in Filmoyo →</AffiliateCta>
      </div>

      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">Before you pick a monthly clip tool.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
      </div>
      <RelatedLinks extra={[{ href: '/filmoyo-vs-invideo', label: 'Filmoyo vs InVideo' }]} />
      <div class="final-band">
        <p class="eyebrow">For filmmakers</p>
        <h2 class="section-title">Choose Runway for a shot. Choose Filmoyo for a film.</h2>
        <p class="lede narrow" style="margin-top: 0.8rem;">
          The full review is on the <a class="text-link" href="/">homepage</a>. The license split is on the <a class="text-link" href="/filmoyo-pricing">pricing page</a>. The extra files are on the <a class="text-link" href="/filmoyo-bonus">bonuses page</a>.
        </p>
        <div class="hero-actions" style="margin-top: 1.1rem;">
          <AffiliateCta extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

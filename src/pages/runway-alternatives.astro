---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateCta from '../components/AffiliateCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { personalPrice } from '../lib/affiliate';

const tools = [
  {
    rank: '1',
    name: 'Filmoyo Director',
    badge: 'Best one-time price and a locked cast',
    text: `The alternative when you are tired of a monthly clip bill and a face that changes between shots. The personal studio is $${personalPrice} once. Character Lock sends one reference sheet into every shot. Credits are finite, and the footage is stylized.`,
    top: true,
  },
  {
    rank: '2',
    name: 'Pika Labs',
    badge: 'Best for short loops',
    text: 'A lighter place to test motion for a few seconds. It is not a storyboard or a cast you can bring back next week.',
    top: false,
  },
  {
    rank: '3',
    name: 'InVideo',
    badge: 'Best for template social videos',
    text: 'Use it when the job is a post that should follow a layout. It is an editor, not a director’s canvas, and it does not include the 9,500-image vault.',
    top: false,
  },
  {
    rank: '4',
    name: 'Sora',
    badge: 'Best photographic clip, if you have access',
    text: 'OpenAI’s Sora is the name people try when they want a more photographic single shot. Access changes. It is not a studio you buy once.',
    top: false,
  },
  {
    rank: '5',
    name: 'Kling',
    badge: 'Another clip generator',
    text: 'Kling is one more monthly-style place to render a shot. Same limit as Runway for a film: the next generation is often a different person unless you force a reference.',
    top: false,
  },
];

const faqs = [
  {
    question: 'Why leave Runway?',
    answer:
      'Runway bills every month, and a new scene is a new generation. The face often drifts. If the job is one effects shot, stay. If the job is a cast across a film, look at a studio instead of another clip plan.',
  },
  {
    question: 'What is the cheapest serious option here?',
    answer: `Filmoyo’s personal license is $${personalPrice} once. That is not unlimited video. It is a license you keep, with 600 Core and 150 PRO credits in the box. Subscription tools can cost less in week one and more by month six.`,
  },
  {
    question: 'Does any alternative guarantee the same face?',
    answer:
      'No tool on this list is magic. Filmoyo is the one built around a locked reference sheet. You still approve frames. A vague cast produces a vague sheet.',
  },
  {
    question: 'Is this a lab ranking?',
    answer:
      'No. It is this site’s 2026 order for people comparing Runway with something they can own. Plans and model names change. Check the live price before you switch.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Top 5 Runway alternatives in 2026',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool) => ({
    '@type': 'ListItem',
    position: Number(tool.rank),
    name: tool.name,
    description: tool.badge,
  })),
};
---

<BaseLayout
  title="Top 5 Runway Alternatives in 2026 (Cheaper & Better)"
  description="Runway alternatives in 2026: Filmoyo Director is first for a one-time price and Character Lock, ahead of Pika, InVideo, Sora, and Kling."
  canonicalURL="/runway-alternatives"
  schema={[faqSchema, itemListSchema]}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Runway alternatives', href: '/runway-alternatives' },
      ]}
    />
  </div>

  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Instead of another month</p>
      <h1>Top 5 Runway Alternatives in 2026</h1>
      <p class="lede" style="margin-top: 0.9rem; max-width: 42rem;">
        Runway is a strong clip tool and an expensive habit. A plan near $15 a month is $180 a year, and the next scene can come back with a different face. These are five other ways to make the picture, with Filmoyo first if you want the cast to hold and the license to stay.
      </p>
      <div class="hero-actions" style="margin-top: 1.3rem; justify-content: flex-start;">
        <AffiliateCta id="get-filmoyo" extraClass="btn-lg">Get the #1 alternative →</AffiliateCta>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <ol class="rank-list">
        {tools.map((tool) => (
          <li>
            <article class:list={['surface', 'rank-card', tool.top && 'is-top']}>
              <p class="rank-num">{tool.rank}</p>
              <div>
                <h2 style="margin: 0 0 0.35rem; font-size: 1.45rem;">{tool.name}</h2>
                <p class="eyebrow" style="margin-bottom: 0.45rem;">{tool.badge}</p>
                <p>{tool.text}</p>
                {tool.top && (
                  <div class="hero-actions" style="margin-top: 1rem; justify-content: flex-start;">
                    <AffiliateCta extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
                  </div>
                )}
              </div>
            </article>
          </li>
        ))}
      </ol>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta>Get the one-time studio →</AffiliateCta>
      </div>
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">Cheaper only counts if you can finish the film.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
      </div>
      <RelatedLinks extra={[{ href: '/filmoyo-vs-runway', label: 'Full Filmoyo vs Runway' }]} />
      <div class="final-band">
        <p class="eyebrow">The switch</p>
        <h2 class="section-title">Own the studio. Stop re-rolling the face.</h2>
        <p class="lede narrow" style="margin-top: 0.8rem;">
          Read the <a class="text-link" href="/">review</a>, compare <a class="text-link" href="/filmoyo-pricing">${personalPrice} and $37</a>, and see the <a class="text-link" href="/filmoyo-bonus">bonuses</a>.
        </p>
        <div class="hero-actions" style="margin-top: 1.1rem;">
          <AffiliateCta extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateCta from '../components/AffiliateCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';

const formula = [
  { name: 'Camera angle', text: 'Where the lens sits: wide, medium, close, low, overhead.' },
  { name: 'Lighting', text: 'The time and the source: golden hour, noon, tungsten, a single practical, rain.' },
  { name: 'Subject', text: 'Who, specifically. Age, clothes, and one detail the audience can track.' },
  { name: 'Action', text: 'One verb. What they do in this shot, not their whole biography.' },
  { name: 'Style', text: 'The look: cinematic, desaturated, shallow focus. One style, not five genres.' },
];

const examples = [
  {
    title: 'A chase',
    bad: 'a man running in a city, cool, cinematic',
    good: 'Low angle, wet asphalt, sodium streetlights. A man in a grey wool coat sprints past a shuttered kiosk, coat hem snapping, shallow focus, cinematic night.',
  },
  {
    title: 'A letter',
    bad: 'woman with a letter, dramatic',
    good: 'Close-up, overcast window light. A woman in her forties with a silver streak in short dark hair breaks the wax seal on a cream envelope, hands steady, muted film color.',
  },
  {
    title: 'A product ad',
    bad: 'ad for headphones, luxury',
    good: 'Medium shot, soft key light from camera left. A commuter on a night train lifts matte black headphones from a linen case, city lights streaking the window, clean commercial grade.',
  },
];

const faqs = [
  {
    question: 'Will a perfect prompt fix a changing face?',
    answer:
      'No. A precise prompt describes the shot. Character Lock is what carries the same person into the next shot. Use both.',
  },
  {
    question: 'How long should a cinematic prompt be?',
    answer:
      'Long enough for angle, light, subject, action, and one style. A paragraph of moods usually fights itself. One action is enough.',
  },
  {
    question: 'Do I still write prompts inside Filmoyo?',
    answer:
      'The Director Canvas drafts shots from a logline, and you can still edit the prompt, angle, shot type, and lighting before you render. The point is you are not inventing every shot from a blank box.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to write a cinematic AI video prompt',
  description: 'Build a shot prompt from camera angle, lighting, subject, action, and style.',
  step: formula.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.name,
    text: step.text,
  })),
};
---

<BaseLayout
  title="How to Write Cinematic Prompts for AI Video (With Examples)"
  description="How to write cinematic AI video prompts: camera angle, lighting, subject, action, and style, with weak prompts rewritten into directed shots."
  canonicalURL="/how-to-write-cinematic-prompts"
  schema={[faqSchema, howToSchema]}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Cinematic prompts', href: '/how-to-write-cinematic-prompts' },
      ]}
    />
  </div>

  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Prompt craft</p>
      <h1>How to Write Cinematic Prompts for AI Video</h1>
      <p class="lede" style="margin-top: 0.9rem; max-width: 42rem;">
        A generic prompt gets a generic picture. A directed shot names the lens, the light, the person, and the one thing they do. That is how you ask for a film frame instead of clip-art.
      </p>
      <div class="hero-actions" style="margin-top: 1.3rem; justify-content: flex-start;">
        <AffiliateCta id="get-filmoyo" extraClass="btn-lg">Skip the prompt writing. Use Filmoyo's AI Director →</AffiliateCta>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <div class="section-head">
        <p class="eyebrow">The formula</p>
        <h2 class="section-title">Angle, light, subject, action, style.</h2>
      </div>
      <ol class="claim-steps">
        {formula.map((part) => (
          <li>
            <strong>{part.name}</strong>
            <span>{part.text}</span>
          </li>
        ))}
      </ol>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta>Let the AI Director draft it →</AffiliateCta>
      </div>

      <div class="section-head">
        <p class="eyebrow">Examples</p>
        <h2 class="section-title">The same idea, written like a shot.</h2>
      </div>
      <div class="prompt-grid">
        {examples.map((example) => (
          <article>
            <h3 style="margin: 0 0 0.55rem; font-size: 1.2rem;">{example.title}</h3>
            <div class="prompt-pair">
              <div class="prompt-bad">
                <p class="eyebrow">Too thin</p>
                <p style="margin-top: 0.4rem;">{example.bad}</p>
              </div>
              <div class="prompt-good">
                <p class="eyebrow">Directed</p>
                <p style="margin-top: 0.4rem;">{example.good}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta extraClass="btn-lg">Skip the prompt writing. Use Filmoyo's AI Director →</AffiliateCta>
      </div>

      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">Prompts and the lock are different jobs.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta>Get Filmoyo Director →</AffiliateCta>
      </div>
      <RelatedLinks extra={[{ href: '/filmoyo-tutorial', label: 'Filmoyo tutorial' }]} />
      <div class="final-band">
        <p class="eyebrow">Or hand the first draft to the canvas</p>
        <h2 class="section-title">You can still edit the shot after the logline.</h2>
        <p class="lede narrow" style="margin-top: 0.8rem;">
          The <a class="text-link" href="/">review</a>, the <a class="text-link" href="/filmoyo-pricing">price</a>, and the <a class="text-link" href="/filmoyo-bonus">50 cinematic prompts bonus</a> sit next to this formula.
        </p>
        <div class="hero-actions" style="margin-top: 1.1rem;">
          <AffiliateCta extraClass="btn-lg">Skip the prompt writing. Use Filmoyo's AI Director →</AffiliateCta>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

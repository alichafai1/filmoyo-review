---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateCta from '../components/AffiliateCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const bonuses = [
  {
    title: '50 Cinematic Prompts',
    worth: 'Worth $47',
    text: 'Ready-to-use loglines for action, drama, sci-fi, and ads. Paste one into Filmoyo instead of staring at a blank sentence.',
  },
  {
    title: 'AI Storyboard Template',
    worth: 'Worth $27',
    text: 'A Notion and PDF template for planning scenes before you spend a credit. Map the shot, then generate it.',
  },
  {
    title: 'Client Contract Template',
    worth: 'Worth $37',
    text: 'A simple contract for selling AI videos to a business. You still need Filmoyo’s commercial license before a client pays you for the work.',
  },
  {
    title: 'Distribution Checklist',
    worth: 'Worth $17',
    text: 'Where to upload a finished film: YouTube, TikTok, and Vimeo, with the settings to check before you hit publish. It is a checklist, not a promise of views.',
  },
];

const claim = [
  { title: 'Buy Filmoyo', text: 'Use a green button on this page. The personal studio is $27. Add $10 at checkout if you will sell the films.' },
  { title: 'Forward the receipt', text: 'Send the order receipt to bonuses@filmoyoreview.com so we can match the purchase.' },
  { title: 'Get the files', text: 'The toolkit arrives by email within 24 hours of a readable receipt.' },
];
---

<BaseLayout
  title="Filmoyo Director Bonus: Claim Your Filmmaker's Toolkit"
  description="Claim the Filmoyo Director filmmaker toolkit: 50 cinematic prompts, a storyboard template, a client contract, and a distribution checklist. $128 value after you buy."
  canonicalURL="/filmoyo-bonus"
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Bonuses' }]} />
  </div>

  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Filmoyo Review toolkit</p>
      <h1>Claim Your Exclusive Filmoyo Bonuses</h1>
      <p class="lede" style="margin-top: 0.9rem; max-width: 40rem;">
        These files are from this review, not a second product inside the studio. They are here to help you plan a film, write the sentence, and publish the cut faster once Filmoyo is in your account.
      </p>
      <div class="hero-actions" style="margin-top: 1.3rem; justify-content: flex-start;">
        <AffiliateCta id="get-filmoyo" extraClass="btn-lg">Get Filmoyo Director + My Bonuses →</AffiliateCta>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <div class="section-head">
        <p class="eyebrow">The bonuses</p>
        <h2 class="section-title">Four files. One receipt.</h2>
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta>Unlock the toolkit →</AffiliateCta>
      </div>
      <div class="bonus-grid">
        {bonuses.map((bonus, index) => (
          <article class="bonus-card">
            <p class="step-num">BONUS {index + 1}</p>
            <h2>{bonus.title}</h2>
            <p class="worth">{bonus.worth}</p>
            <p>{bonus.text}</p>
          </article>
        ))}
      </div>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta extraClass="btn-lg">Get Filmoyo Director →</AffiliateCta>
      </div>
      <div class="value-box">
        <p class="eyebrow">Total value</p>
        <strong>$128 Value. Yours Free.</strong>
        <p class="lede">Free with a Filmoyo purchase through this page. You pay the studio price on the checkout. You do not pay again for these four files.</p>
        <div class="hero-actions" style="margin-top: 1rem;">
          <AffiliateCta>Claim the $128 toolkit →</AffiliateCta>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container stack-lg">
      <div class="section-head">
        <p class="eyebrow">What the files are for</p>
        <h2 class="section-title">Use them on the first film, not as a second product.</h2>
        <p class="lede">
          The 50 cinematic prompts are loglines you can paste when the page is blank: action, drama, sci-fi, and ads. They are starters. The Director’s Canvas still breaks the sentence into shots, and you still approve each frame. The storyboard template, in Notion and as a PDF, is where you plan those shots before you spend a credit, so you are not discovering the story inside the generator.
        </p>
        <p class="lede">
          The client contract is a simple agreement for when a business pays you for an AI video. It does not replace Filmoyo’s commercial license. That right is the $10 checkbox on the order form, $37 total. The distribution checklist names where a finished, watermark-free film can go, including YouTube, TikTok, and Vimeo, and what to check before you publish. It is a list, not a traffic promise.
        </p>
        <p class="lede">
          None of these files are inside the Filmoyo app unless the vendor also lists them. They come from this review after a readable receipt hits bonuses@filmoyoreview.com. One purchase, one toolkit, aimed at 24 hours. The <a class="text-link" href="/">review</a> explains the studio those files sit on top of.
        </p>
      </div>
      <div class="section-head">
        <p class="eyebrow">How to claim</p>
        <h2 class="section-title">Buy, forward the receipt, get the files.</h2>
      </div>
      <ol class="claim-steps">
        {claim.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
      <p class="fine">Send the receipt to <a class="text-link" href="mailto:bonuses@filmoyoreview.com">bonuses@filmoyoreview.com</a>. One purchase, one toolkit.</p>
      <div class="hero-actions" style="justify-content: flex-start;">
        <AffiliateCta extraClass="btn-lg">Buy Filmoyo and claim the bonuses →</AffiliateCta>
      </div>
      <div class="final-band">
        <p class="eyebrow">Ready when the receipt is</p>
        <h2 class="section-title">The studio is the purchase. The toolkit is the extra.</h2>
        <p class="lede narrow" style="margin-top: 0.8rem;">
          Character Lock and the frame-first workspace are what you are buying. These four files are how this review helps you use them on the first film.
        </p>
        <div class="hero-actions" style="margin-top: 1.1rem;">
          <AffiliateCta extraClass="btn-lg">Get Filmoyo Director + My Bonuses →</AffiliateCta>
          <a class="text-link" href="/filmoyo-pricing">See $27 vs $37</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
